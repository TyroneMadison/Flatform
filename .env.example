# Copy this file to .env for `npm run web`. Keys pasted in the app's Settings win over these.
# Tripo: create a key at https://developers.tripo3d.com/en/keys
TRIPO_API_KEY=
# 3D AI Studio: create a key in its API dashboard (https://www.3daistudio.com/Platform/API/Documentation)
THREE_D_AI_STUDIO_KEY=
# Optional
# TRIPO_MODEL=v3.1-20260211
# PORT=5173
# TRIPO_BASE overrides the Region setting (China-region keys: https://openapi.tripo3d.com/v3)
# TRIPO_BASE=https://openapi.tripo3d.ai/v3
# THREE_D_AI_STUDIO_BASE=https://api.3daistudio.com
