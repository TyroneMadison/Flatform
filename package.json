{
  "name": "flatform",
  "productName": "Flatform",
  "version": "0.5.0",
  "description": "Drop a photo, get a 3D car from Tripo or 3D AI Studio, stage it in a studio and render 360/180 turntables for the web",
  "author": "Tyrone Madison",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "electron .",
    "web": "node --env-file=.env server.mjs",
    "test": "node --test test.mjs test/pipeline.test.mjs test/pricing.test.mjs test/providers.test.mjs test/threedai.test.mjs test/updates.test.mjs test/ledger.test.mjs test/camera.test.mjs test/tenno.test.mjs test/look.test.mjs test/infer.test.mjs test/motion.test.mjs test/turntable.test.mjs test/batch.test.mjs test/phase4.test.mjs test/tennogen.test.mjs test/import.test.mjs test/poses.test.mjs test/model-tools.test.mjs test/camera-path.test.mjs test/lighting.test.mjs test/local.test.mjs test/textures.test.mjs test/decals.test.mjs test/templates.test.mjs test/spin.test.mjs test/theme-contrast.test.mjs test/enhance.test.mjs test/groupb.test.mjs test/groupc.test.mjs test/groupd.test.mjs test/groupe.test.mjs test/handpose.test.mjs",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "heic-convert": "2.1.0",
    "three": "0.186.1",
    "three-gpu-pathtracer": "0.0.27",
    "three-mesh-bvh": "0.9.16"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "io.github.tyronemadison.tripostudio",
    "productName": "Flatform",
    "files": [
      "main.mjs",
      "server.mjs",
      "providers.mjs",
      "keys.mjs",
      "ledger.mjs",
      "enhance.mjs",
      "share.mjs",
      "overnight.mjs",
      "plugins.mjs",
      "backup.mjs",
      "usage.mjs",
      "updates.mjs",
      "png.mjs",
      "inference.mjs",
      "batch.mjs",
      "video.mjs",
      "workspaces.mjs",
      "local.mjs",
      "textures.mjs",
      "spin.mjs",
      "realism.mjs",
      "handoff.mjs",
      "preload.cjs",
      "public/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "preview.mjs"
    ],
    "extraResources": [
      {
        "from": "render/blender_turntable.py",
        "to": "render/blender_turntable.py"
      },
      {
        "from": "node_modules/three/examples/jsm",
        "to": "three/examples/jsm"
      },
      {
        "from": "public/img/hdri",
        "to": "hdri"
      },
      {
        "from": "local",
        "to": "local"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false
    },
    "publish": {
      "provider": "github",
      "owner": "TyroneMadison",
      "repo": "Flatform"
    }
  }
}
